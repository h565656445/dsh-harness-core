{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local.hermes/schemas/task_contract.schema.json",
  "title": "Hermes Harness TaskContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "created_at",
    "state",
    "request",
    "goal",
    "understanding",
    "clarification_questions",
    "route_plan",
    "constraints",
    "deliverables",
    "acceptance",
    "authority",
    "loop_policy"
  ],
  "properties": {
    "schema_version": { "enum": ["1.0", "1.1"] },
    "task_id": {
      "type": "string",
      "pattern": "^task-[0-9]{8}-[0-9]{6}-[a-f0-9]{8}$"
    },
    "created_at": { "type": "string", "minLength": 1 },
    "state": {
      "enum": [
        "waiting_for_user",
        "waiting_for_approval",
        "routed",
        "dispatched",
        "evaluating",
        "retrying",
        "completed",
        "failed"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw"],
      "properties": {
        "raw": { "type": "string", "minLength": 1 }
      }
    },
    "goal": { "type": "string", "minLength": 1 },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materials"],
      "properties": {
        "materials": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "source_path", "snapshot_path", "sha256", "trust"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "source_path": { "type": "string", "minLength": 1 },
              "snapshot_path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
              "trust": { "enum": ["provided", "verified"] }
            }
          }
        }
      }
    },
    "understanding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domains",
        "actions",
        "channels",
        "confidence",
        "uncertainties",
        "evidence"
      ],
      "properties": {
        "domains": { "$ref": "#/definitions/stringArray" },
        "actions": { "$ref": "#/definitions/stringArray" },
        "channels": { "$ref": "#/definitions/stringArray" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "uncertainties": { "$ref": "#/definitions/stringArray" },
        "evidence": { "type": "object" }
      }
    },
    "clarification_questions": { "$ref": "#/definitions/stringArray" },
    "route_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "project_id",
          "project_name",
          "project_root",
          "project_memory",
          "matched_domains",
          "matched_actions",
          "depends_on"
        ],
        "properties": {
          "step_id": { "type": "string", "pattern": "^step-[1-9][0-9]*$" },
          "project_id": { "type": "string", "minLength": 1 },
          "project_name": { "type": "string", "minLength": 1 },
          "project_root": { "type": "string", "minLength": 1 },
          "project_memory": { "type": "string", "minLength": 1 },
          "matched_domains": { "$ref": "#/definitions/stringArray" },
          "matched_actions": { "$ref": "#/definitions/stringArray" },
          "depends_on": { "$ref": "#/definitions/stringArray" }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_seconds"],
      "properties": {
        "duration_seconds": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    },
    "deliverables": { "$ref": "#/definitions/nonEmptyStringArray" },
    "acceptance": { "$ref": "#/definitions/nonEmptyStringArray" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_approval", "pending_actions"],
      "properties": {
        "requires_approval": { "type": "boolean" },
        "pending_actions": { "$ref": "#/definitions/stringArray" }
      }
    },
    "loop_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "max_repairs", "no_progress_limit"],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 2 },
        "max_repairs": { "type": "integer", "minimum": 0, "maximum": 1 },
        "no_progress_limit": { "type": "integer", "minimum": 1, "maximum": 1 }
      }
    }
  },
  "definitions": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
